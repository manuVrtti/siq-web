# SelectIQ — environment variable template
#
# PLACEHOLDERS ONLY. This file is committed to git. Never put a real value here.
#
# Where real values go:
#   .env        DATABASE_URL and DIRECT_URL only. The Prisma CLI reads .env and
#               never reads .env.local, so the database URLs must live here.
#   .env.local  Everything else. Next.js reads both; .env.local wins.
#
# Both are git-ignored. Validation lives in src/lib/env.ts — a missing or
# malformed value fails with the variable name rather than a vague crash.

# ============================================
# DATABASE (Prisma -> Supabase PostgreSQL)
# ============================================
# Supabase Dashboard -> Project Settings -> Database -> Connection string
#
# Use the POOLER hosts (...pooler.supabase.com). The direct host
# db.<ref>.supabase.co is IPv6-only on the free tier and hangs on most Indian
# ISPs. Pooler usernames are postgres.<project-ref>, not plain postgres.

# Transaction pooler, port 6543 — app runtime, serverless-safe
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler, port 5432 — used by Prisma migrations
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ============================================
# SUPABASE (file storage only — never DB queries)
# ============================================
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER prefix with NEXT_PUBLIC_
# Bypasses row level security. Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# FIREBASE CLIENT (public — safe for the browser)
# ============================================
# Firebase Console -> Project Settings -> General -> Your apps -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ============================================
# FIREBASE ADMIN (server-side only — NEVER expose)
# ============================================
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes. Literal \n sequences are converted at runtime.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# ============================================
# MSG91 (phone OTP — server-side only)
# ============================================
# MSG91 Dashboard -> API Keys. DLT-registered template required for Indian carriers.
MSG91_AUTH_KEY=your-auth-key
MSG91_TEMPLATE_ID=your-template-id
MSG91_SENDER_ID=your-sender-id

# ============================================
# JUDGE0 (code execution — server-side only)
# ============================================
# Your self-hosted Judge0 CE instance
JUDGE0_API_URL=http://your-judge0-host:2358
JUDGE0_API_KEY=your-api-key-if-configured

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
