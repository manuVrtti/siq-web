# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/

# Production
# Anchored (leading /) so these only match the repo root — an unanchored
# `build/` also matches nested route directories like
# src/app/(protected)/[org]/assessments/[id]/build/, which silently swallowed
# a real page. Same for dist/.
/build/
/dist/

# Environment variables — NEVER commit
# Everything env-shaped, including editor and tooling backups such as
# .env.local.bak / .env.local.save / .env.local~ — those are full copies of
# live credentials and were previously NOT matched by exact-name patterns.
.env*
# ...except the committed placeholder template.
!.env.example

# Vercel
.vercel

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Prisma
prisma/*.db
prisma/*.db-journal

# Testing
coverage/
.nyc_output/

# Misc
*.pem
*.log

/src/generated/prisma
