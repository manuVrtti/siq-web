// SelectIQ — Prisma schema
// Plan 003 — Prisma + Supabase Database Connection
//
// Prisma is the ONLY ORM. ALL database reads/writes go through Prisma.
// Never query the database via the Supabase client — Supabase is storage-only.
//
// Conventions:
//   - cuid() primary keys
//   - createdAt / updatedAt on every mutable model
//   - enums are SCREAMING_SNAKE_CASE
//
// After any change to this file:
//   npm run db:generate   (always)
//   npm run db:migrate    (development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's transaction pooler cannot run migrations. directUrl points at
  // the session pooler so `prisma migrate` has a stable single connection.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE_ADMIN
  /// Head of department: everything a College Admin can do, limited to the
  /// department(s) they head (DepartmentHead). Cannot change college settings.
  COLLEGE_HOD
  RECRUITER
  STUDENT
}

enum OrgType {
  COLLEGE
  COMPANY
}

/// Platform-level state of an organization (Super Admin only).
/// SUSPENDED pauses every member's access (contract ended, payment due…);
/// nothing is deleted and reactivating restores it.
enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OrgMemberRole {
  ADMIN
  MEMBER
}

/// Mirror of a Firebase Auth user plus SelectIQ app-level data.
/// `firebaseUid` is the join key between the Firebase session and this table.
model User {
  id              String    @id @default(cuid())
  /// Null for phone-OTP-only accounts (MSG91 → Firebase custom token).
  email           String?   @unique
  /// Null for OAuth-only accounts. E.164 format.
  phone           String?   @unique
  name            String?
  avatarUrl       String?
  role            UserRole  @default(STUDENT)
  firebaseUid     String    @unique
  lastLoginAt     DateTime?
  /// When the user finished (or skipped) their role's welcome journey.
  /// Null = show /[org]/welcome on their next dashboard visit.
  onboardedAt     DateTime?
  /// Super Admin suspension. While set: no sign-in, every session rejected,
  /// and the Firebase account is disabled. Data is kept; reactivating clears it.
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships        OrganizationMember[]
  auditLogs          AuditLog[]
  authoredQuestions  Question[]
  createdAssessments Assessment[]
  batchMemberships   BatchMember[]
  assignments        AssessmentAssignment[]
  examAttempts       ExamAttempt[]
  results            Result[]
  proctoringSessions ProctoringSession[]
  candidateProfile   CandidateProfile?
  headOf             DepartmentHead[]

  notificationsCreated Notification[]     @relation("NotificationAuthor")
  notificationReads    NotificationRead[]
  userNotifications    UserNotification[] @relation("UserNotifications")

  @@index([role])
}

/// A college or a hiring company. Users join via OrganizationMember.
model Organization {
  id                     String    @id @default(cuid())
  name                   String
  type                   OrgType
  /// URL-safe tenant identifier: "abes" in selectsiq.in/abes/... (and later
  /// abes.selectsiq.in). Lowercase letters, digits and hyphens only. Required
  /// and permanent — it is the routing key, and changing it breaks every saved
  /// link. (Plan T01 — was nullable before any org existed.)
  slug                   String    @unique
  /// Email domain used to match students to their college, e.g. "abes.ac.in".
  /// Distinct from `slug`: a college may have several email domains but only
  /// one URL, and dots are not valid in a subdomain label.
  domain                 String?
  logoUrl                String?
  /// Where the college is — lets the console segment hundreds of colleges.
  city                   String?
  state                  String?
  status                 OrgStatus @default(ACTIVE)
  suspendedAt            DateTime?
  suspendedReason        String?
  /// Departments: when true, students choose their department at registration
  /// (admins/HODs can still move them); when false, only the college assigns it.
  studentsPickDepartment Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  members     OrganizationMember[]
  departments Department[]
  questions   Question[]
  tags        Tag[]
  assessments Assessment[]
  batches     Batch[]

  notifications     Notification[]
  userNotifications UserNotification[]
  topicSections     TopicSection[]
  skillNodes        SkillNode[]

  @@index([type])
  @@index([status])
}

/// Join table between User and Organization, carrying the org-scoped role.
model OrganizationMember {
  id       String        @id @default(cuid())
  userId   String
  orgId    String
  role     OrgMemberRole @default(MEMBER)
  joinedAt DateTime      @default(now())

  /// A student's department in THIS college (a student in two colleges has
  /// one per membership). Null = unassigned: visible to College Admins only.
  departmentId String?

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([departmentId])
}

/// An academic department of a college, e.g. "Computer Science & Engineering" (CSE).
model Department {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  /// Short code shown in chips and filters, e.g. "CSE". Unique per college.
  code      String
  createdAt DateTime @default(now())

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  heads       DepartmentHead[]
  members     OrganizationMember[]
  assessments Assessment[]
  batches     Batch[]

  notifications Notification[]

  @@unique([orgId, code])
  @@unique([orgId, name])
  @@index([orgId])
}

/// Which HOD heads which department. Many-to-many: a College Admin can give
/// one HOD several departments, or a department several HODs/coordinators.
model DepartmentHead {
  departmentId String
  userId       String
  assignedAt   DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([departmentId, userId])
  @@index([userId])
}

/// Append-only trail of user actions. Never updated, only inserted.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// Plan 011 — Question Bank
// ============================================================

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  SUBJECTIVE
  CODING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// A reusable question owned by an organization. Assembled into assessments
/// (Plan 012). Type-specific answer data lives in QuestionOption for the
/// choice types; CODING test cases arrive in Plan 014.
model Question {
  id            String       @id @default(cuid())
  orgId         String
  type          QuestionType
  title         String
  body          String       @db.Text
  difficulty    Difficulty   @default(MEDIUM)
  marks         Int          @default(1)
  negativeMarks Float        @default(0)
  explanation   String?      @db.Text
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a user must not silently delete the
  // questions they authored — those belong to the org.
  createdBy           User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  options             QuestionOption[]
  tags                QuestionTag[]
  topic               QuestionTopic?
  skills              QuestionSkill[]
  assessmentQuestions AssessmentQuestion[]

  @@index([orgId])
  @@index([type])
  @@index([difficulty])
}

/// An answer choice for MCQ / multi-select / true-false questions.
model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/// Topic / skill label, unique per organization.
model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  category  String?
  createdAt DateTime @default(now())

  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  questions QuestionTag[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Many-to-many join between Question and Tag.
model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

// ============================================================
// Plan 012 — Assessment Builder
// ============================================================

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScoringPolicy {
  STANDARD
  NEGATIVE_MARKING
}

/// A configurable, timed assessment: global config plus ordered sections of
/// questions. Org-owned; DRAFT until validated and published.
model Assessment {
  id                  String           @id @default(cuid())
  orgId               String
  title               String
  description         String?          @db.Text
  status              AssessmentStatus @default(DRAFT)
  durationMinutes     Int
  scoringPolicy       ScoringPolicy    @default(STANDARD)
  maxAttempts         Int              @default(1)
  shuffleQuestions    Boolean          @default(false)
  shuffleOptions      Boolean          @default(false)
  passingScore        Float?
  startAt             DateTime?
  endAt               DateTime?
  /// Plan 018 — turns on webcam capture + activity monitoring during the attempt.
  /// Plan 021: counts toward students' strengths & weaknesses. When true,
  /// publishing requires every question tagged with a topic + ≥1 skill.
  countsForAnalytics  Boolean          @default(false)
  proctoringEnabled   Boolean          @default(false)
  /// Snapshot cadence in seconds. Ignored when proctoringEnabled is false.
  snapshotIntervalSec Int              @default(30)
  /// When false, snapshots are analysed and discarded; only flags persist.
  storeSnapshots      Boolean          @default(true)
  /// Cosine-similarity threshold below which a snapshot triggers FACE_MISMATCH.
  faceMatchThreshold  Float            @default(0.6)
  createdById         String
  /// Owning department. Null = college-wide (College Admin). HOD-created
  /// assessments always carry one, so other departments' HODs can't edit them.
  departmentId        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  org         Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department  Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sections    AssessmentSection[]
  assignments AssessmentAssignment[]
  results     Result[]

  @@index([orgId])
  @@index([status])
}

/// A named group of questions within an assessment, optionally its own timer.
model AssessmentSection {
  id              String  @id @default(cuid())
  assessmentId    String
  title           String
  description     String?
  order           Int
  durationMinutes Int?

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  AssessmentQuestion[]

  @@index([assessmentId])
}

/// A question placed in a section, with optional per-assessment marks override.
model AssessmentQuestion {
  id            String @id @default(cuid())
  sectionId     String
  questionId    String
  order         Int
  marksOverride Int?

  section  AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  // Restrict: a question used in an assessment cannot be silently deleted from
  // under it — remove it from the assessment first.
  question Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sectionId, questionId])
  @@index([sectionId])
}

// ============================================================
// Plan 013 — Candidate Management & Assignment
// ============================================================

enum AssignmentStatus {
  INVITED
  STARTED
  SUBMITTED
  EXPIRED
}

/// An org-owned grouping of candidates (e.g. "2026 CSE Batch").
model Batch {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  description  String?
  /// Owning department (null = college-wide). Same rule as Assessment.
  departmentId String?
  createdAt    DateTime @default(now())

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members    BatchMember[]

  @@unique([orgId, name])
  @@index([orgId])
}

model BatchMember {
  batchId String
  userId  String
  addedAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([batchId, userId])
  @@index([userId])
}

/// An assessment assigned to a candidate. `token` forms the candidate's
/// personal exam link. One row per (assessment, user) — enforced by unique.
model AssessmentAssignment {
  id           String           @id @default(cuid())
  assessmentId String
  userId       String
  token        String           @unique @default(cuid())
  status       AssignmentStatus @default(INVITED)
  invitedAt    DateTime         @default(now())
  startedAt    DateTime?
  submittedAt  DateTime?
  expiresAt    DateTime?

  assessment Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt    ExamAttempt?

  @@unique([assessmentId, userId])
  @@index([token])
  @@index([userId])
  @@index([status])
}

// ============================================================
// Plan 015 — Exam-Taking Runtime
// ============================================================

/// One in-progress or completed attempt at an assigned assessment.
/// Timer is server-authoritative: deadlineAt is set at start and enforced on
/// every save/submit. questionOrder pins the shuffle so refreshes see the
/// same order.
model ExamAttempt {
  id             String    @id @default(cuid())
  assignmentId   String    @unique
  userId         String
  assessmentId   String
  startedAt      DateTime  @default(now())
  deadlineAt     DateTime
  submittedAt    DateTime?
  /// { sections: [{ sectionId, questionIds: string[] }] }
  questionOrder  Json
  currentSection Int       @default(0)

  assignment        AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           ExamAnswer[]
  result            Result?
  proctoringSession ProctoringSession?

  @@index([userId])
  @@index([assessmentId])
}

/// One saved answer per (attempt, question). Autosaved as the candidate works.
model ExamAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  /// String[] to support both single- and multi-select MCQs uniformly.
  selectedOptionIds String[]
  textAnswer        String?  @db.Text
  /// codeSubmissionId — reserved for Plan 014 (Judge0). Nullable for now.
  codeSubmissionId  String?
  savedAt           DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ============================================================
// Plan 016 — Grading Engine & Results
// ============================================================

enum ResultStatus {
  /// At least one question needs manual review (subjective, or coding pre Plan 014).
  PENDING_REVIEW
  /// Fully scored; totalScore and passed are final.
  GRADED
}

/// One graded outcome per exam attempt. Auto-created when the attempt is
/// submitted (services/grading.ts gradeAttempt).
model Result {
  id           String       @id @default(cuid())
  attemptId    String       @unique
  assessmentId String
  userId       String
  status       ResultStatus @default(PENDING_REVIEW)
  totalScore   Float        @default(0)
  maxScore     Float
  percentage   Float        @default(0)
  passed       Boolean?
  gradedAt     DateTime?
  createdAt    DateTime     @default(now())

  attempt         ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionResults QuestionResult[]

  @@index([assessmentId])
  @@index([userId])
  @@index([status])
}

/// Per-question breakdown of a Result.
model QuestionResult {
  id           String   @id @default(cuid())
  resultId     String
  questionId   String
  scoreAwarded Float    @default(0)
  maxMarks     Float
  isCorrect    Boolean?
  /// True while awaiting manual review (subjective, coding). Prevents result finalisation.
  needsReview  Boolean  @default(false)
  reviewedById String?
  feedback     String?  @db.Text

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([questionId])
}

// ============================================================
// Plan 018 — Proctoring: face + activity monitoring
// ============================================================

enum ProctoringFlagType {
  NO_FACE
  MULTIPLE_FACES
  FACE_MISMATCH
  TAB_SWITCH
  FOCUS_LOSS
  FULLSCREEN_EXIT
  WINDOW_BLUR
  WEBCAM_DENIED
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
}

/// One proctoring session per exam attempt. Created when the candidate grants
/// webcam access; the reference photo is captured immediately after.
model ProctoringSession {
  id                String   @id @default(cuid())
  attemptId         String   @unique
  userId            String
  /// Supabase Storage path (private bucket) of the reference photo taken at
  /// exam start. Null when either proctoringEnabled=false or the candidate
  /// denied webcam access — either way, no photo exists.
  referencePhotoUrl String?
  snapshotCount     Int      @default(0)
  flagCount         Int      @default(0)
  createdAt         DateTime @default(now())

  attempt ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  flags   ProctoringFlag[]

  @@index([userId])
}

/// One entry per proctoring event. Client-side detection posts these to
/// /api/exam/[token]/proctoring/flag as they occur.
model ProctoringFlag {
  id          String             @id @default(cuid())
  sessionId   String
  type        ProctoringFlagType
  severity    FlagSeverity       @default(LOW)
  /// Supabase Storage path if the trigger snapshot was stored. Absent when
  /// Assessment.storeSnapshots=false or the trigger has no visual (activity
  /// events like TAB_SWITCH).
  snapshotUrl String?
  /// Cosine-similarity score for FACE_MISMATCH; null for every other type.
  similarity  Float?
  /// Free-form context (e.g. faceCount for MULTIPLE_FACES, durationMs for
  /// FOCUS_LOSS).
  metadata    Json?
  occurredAt  DateTime           @default(now())

  session ProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
}

// ============================================================
// Candidate profile (ABtalks-inspired; overlaps plans 027 / 036)
// ============================================================

enum ExperienceKind {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  FREELANCE
}

/// One per user, owned by the candidate, visible to managers of any college
/// the candidate belongs to. `completedAt` is set once the registration step
/// is done; the registration gate keys off it.
model CandidateProfile {
  id     String @id @default(cuid())
  userId String @unique

  headline String?
  about    String? @db.Text
  city     String?

  // Current degree — what placement cells filter on.
  rollNumber     String?
  degree         String?
  branch         String?
  graduationYear Int?
  /// On a 10-point scale.
  cgpa           Float?
  tenthPercent   Float?
  twelfthPercent Float?
  activeBacklogs Int?

  skills String[]

  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  codingUrl    String?

  /// Supabase Storage path in the private "resumes" bucket.
  resumePath       String?
  resumeFileName   String?
  resumeUploadedAt DateTime?

  preferredRoles     String[]
  preferredLocations String[]
  openToRelocate     Boolean?
  /// Expected CTC in lakhs per annum.
  expectedCtcLpa     Float?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  education    CandidateEducation[]
  experience   CandidateExperience[]
  projects     CandidateProject[]
  achievements CandidateAchievement[]

  @@index([branch])
  @@index([graduationYear])
}

model CandidateEducation {
  id          String  @id @default(cuid())
  profileId   String
  institution String
  degree      String
  field       String?
  startYear   Int?
  endYear     Int?
  /// Free text so "8.4 CGPA" and "91%" both fit.
  score       String?
  order       Int

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CandidateExperience {
  id          String         @id @default(cuid())
  profileId   String
  company     String
  role        String
  kind        ExperienceKind @default(INTERNSHIP)
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean        @default(false)
  description String?        @db.Text
  order       Int

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CandidateProject {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  description String?  @db.Text
  techStack   String[]
  url         String?
  order       Int

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CandidateAchievement {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  issuer      String?
  date        DateTime?
  url         String?
  description String?   @db.Text
  order       Int

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ============================================================
// Notifications (in-app bell) — ported from ABTalks plans 067 / 118
// ============================================================

/// Who a broadcast announcement is for, inside its org (or platform-wide).
enum NotificationAudience {
  ALL
  /// Students only.
  STUDENTS
  /// College Admins, HODs and recruiters — everyone who manages.
  STAFF
}

/// Icon in the bell. Nothing branches on it.
enum NotificationCategory {
  GENERAL
  ASSESSMENT
  RESULT
  REVIEW
  SYSTEM
}

/// Broadcast announcement, written from the Announcements page.
///
/// Scope: orgId null = every college (Super Admin only). departmentId set =
/// only that department's members (HODs must set one of theirs). Automated
/// notifications (open tests, pending reviews) are NOT stored here — they are
/// derived at read time in src/features/notification/derive.ts.
model Notification {
  id           String               @id @default(cuid())
  orgId        String?
  departmentId String?
  title        String
  body         String?
  /// Internal path ("/abes/my-assessments") or absolute https:// URL.
  href         String?
  category     NotificationCategory @default(GENERAL)
  audience     NotificationAudience @default(ALL)
  publishedAt  DateTime             @default(now())
  /// After this it stops showing in the bell. Null = no expiry.
  expiresAt    DateTime?
  /// Deactivate instead of delete (reversible).
  isActive     Boolean              @default(true)
  createdById  String?
  createdAt    DateTime             @default(now())

  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User?         @relation("NotificationAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, isActive, publishedAt(sort: Desc)])
}

/// Per-user read state for broadcast, derived and personal notifications.
/// `notificationKey` is deliberately not a foreign key: derived items have
/// no row. Keys are stable and never reused ("admin:<id>", "user:<id>",
/// "open:<assignmentId>", "review:<assessmentId>:<count>").
model NotificationRead {
  id              String   @id @default(cuid())
  userId          String
  notificationKey String
  readAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([userId])
}

/// A notification addressed to one person about one entity (e.g. "your result
/// is ready"). Dedupe is enforced by the unique dedupeKey.
model UserNotification {
  id              String   @id @default(cuid())
  recipientUserId String
  /// Workspace it belongs to; null shows in every workspace.
  orgId           String?
  /// Key from EVENT_TYPE_REGISTRY — a String, not an enum, so adding one
  /// needs no migration.
  eventType       String
  title           String
  body            String?
  href            String?
  dedupeKey       String   @unique
  primaryEntityId String?
  metadata        Json?
  createdAt       DateTime @default(now())

  recipient User          @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt(sort: Desc)])
}

// ============================================================
// Plan 021 — two-axis taxonomy: Topic (coarse) + Skill (fine)
// ============================================================

/// A topic area a student is scored on (DSA, DBMS, Aptitude…). orgId null =
/// the shared platform spine (same meaning in every college, so colleges
/// stay comparable); otherwise a college's own addition.
model TopicSection {
  id          String   @id @default(cuid())
  orgId       String?
  name        String
  /// Stable key, e.g. "DSA". Unique per scope (platform, or one college) — enforced in services/taxonomy.ts.
  code        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  org       Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  skills    SkillNode[]
  questions QuestionTopic[]

  @@index([orgId])
}

/// A fine-grained skill under a topic, e.g. DSA → "Dynamic Programming".
model SkillNode {
  id        String   @id @default(cuid())
  orgId     String?
  sectionId String
  name      String
  code      String
  /// Alternative spellings for normalisation, lower-case: ["dp", "dynamic programming"].
  aliases   String[]
  createdAt DateTime @default(now())

  section   TopicSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  org       Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  questions QuestionSkill[]

  @@index([sectionId])
  @@index([orgId])
}

/// Exactly one topic per question.
model QuestionTopic {
  questionId String @id
  sectionId  String

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  section  TopicSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([sectionId])
}

/// One or more skills per question.
model QuestionSkill {
  questionId String
  skillId    String

  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill    SkillNode @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([questionId, skillId])
  @@index([skillId])
}
