// SelectIQ — Prisma schema
// Plan 003 — Prisma + Supabase Database Connection
//
// Prisma is the ONLY ORM. ALL database reads/writes go through Prisma.
// Never query the database via the Supabase client — Supabase is storage-only.
//
// Conventions:
//   - cuid() primary keys
//   - createdAt / updatedAt on every mutable model
//   - enums are SCREAMING_SNAKE_CASE
//
// After any change to this file:
//   npm run db:generate   (always)
//   npm run db:migrate    (development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's transaction pooler cannot run migrations. directUrl points at
  // the session pooler so `prisma migrate` has a stable single connection.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE_ADMIN
  RECRUITER
  STUDENT
}

enum OrgType {
  COLLEGE
  COMPANY
}

enum OrgMemberRole {
  ADMIN
  MEMBER
}

/// Mirror of a Firebase Auth user plus SelectIQ app-level data.
/// `firebaseUid` is the join key between the Firebase session and this table.
model User {
  id String @id @default(cuid())
  /// Null for phone-OTP-only accounts (MSG91 → Firebase custom token).
  email       String?   @unique
  /// Null for OAuth-only accounts. E.164 format.
  phone       String?   @unique
  name        String?
  avatarUrl   String?
  role        UserRole  @default(STUDENT)
  firebaseUid String    @unique
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships        OrganizationMember[]
  auditLogs          AuditLog[]
  authoredQuestions  Question[]
  createdAssessments Assessment[]
  batchMemberships   BatchMember[]
  assignments        AssessmentAssignment[]
  examAttempts       ExamAttempt[]
  results            Result[]

  @@index([role])
}

/// A college or a hiring company. Users join via OrganizationMember.
model Organization {
  id   String  @id @default(cuid())
  name String
  type OrgType
  /// URL-safe tenant identifier: "abes" in selectsiq.in/abes/... (and later
  /// abes.selectsiq.in). Lowercase letters, digits and hyphens only. Required
  /// and permanent — it is the routing key, and changing it breaks every saved
  /// link. (Plan T01 — was nullable before any org existed.)
  slug String @unique
  /// Email domain used to match students to their college, e.g. "abes.ac.in".
  /// Distinct from `slug`: a college may have several email domains but only
  /// one URL, and dots are not valid in a subdomain label.
  domain String?
  logoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  questions   Question[]
  tags        Tag[]
  assessments Assessment[]
  batches     Batch[]

  @@index([type])
}

/// Join table between User and Organization, carrying the org-scoped role.
model OrganizationMember {
  id       String        @id @default(cuid())
  userId   String
  orgId    String
  role     OrgMemberRole @default(MEMBER)
  joinedAt DateTime      @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Append-only trail of user actions. Never updated, only inserted.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// Plan 011 — Question Bank
// ============================================================

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  SUBJECTIVE
  CODING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// A reusable question owned by an organization. Assembled into assessments
/// (Plan 012). Type-specific answer data lives in QuestionOption for the
/// choice types; CODING test cases arrive in Plan 014.
model Question {
  id            String       @id @default(cuid())
  orgId         String
  type          QuestionType
  title         String
  body          String       @db.Text
  difficulty    Difficulty   @default(MEDIUM)
  marks         Int          @default(1)
  negativeMarks Float        @default(0)
  explanation   String?      @db.Text
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a user must not silently delete the
  // questions they authored — those belong to the org.
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  options   QuestionOption[]
  tags      QuestionTag[]
  assessmentQuestions AssessmentQuestion[]

  @@index([orgId])
  @@index([type])
  @@index([difficulty])
}

/// An answer choice for MCQ / multi-select / true-false questions.
model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/// Topic / skill label, unique per organization.
model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  category  String?
  createdAt DateTime @default(now())

  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  questions QuestionTag[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Many-to-many join between Question and Tag.
model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

// ============================================================
// Plan 012 — Assessment Builder
// ============================================================

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScoringPolicy {
  STANDARD
  NEGATIVE_MARKING
}

/// A configurable, timed assessment: global config plus ordered sections of
/// questions. Org-owned; DRAFT until validated and published.
model Assessment {
  id               String           @id @default(cuid())
  orgId            String
  title            String
  description      String?          @db.Text
  status           AssessmentStatus @default(DRAFT)
  durationMinutes  Int
  scoringPolicy    ScoringPolicy    @default(STANDARD)
  maxAttempts      Int              @default(1)
  shuffleQuestions Boolean          @default(false)
  shuffleOptions   Boolean          @default(false)
  passingScore     Float?
  startAt          DateTime?
  endAt            DateTime?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sections    AssessmentSection[]
  assignments AssessmentAssignment[]
  results     Result[]

  @@index([orgId])
  @@index([status])
}

/// A named group of questions within an assessment, optionally its own timer.
model AssessmentSection {
  id              String  @id @default(cuid())
  assessmentId    String
  title           String
  description     String?
  order           Int
  durationMinutes Int?

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  AssessmentQuestion[]

  @@index([assessmentId])
}

/// A question placed in a section, with optional per-assessment marks override.
model AssessmentQuestion {
  id            String @id @default(cuid())
  sectionId     String
  questionId    String
  order         Int
  marksOverride Int?

  section  AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  // Restrict: a question used in an assessment cannot be silently deleted from
  // under it — remove it from the assessment first.
  question Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sectionId, questionId])
  @@index([sectionId])
}

// ============================================================
// Plan 013 — Candidate Management & Assignment
// ============================================================

enum AssignmentStatus {
  INVITED
  STARTED
  SUBMITTED
  EXPIRED
}

/// An org-owned grouping of candidates (e.g. "2026 CSE Batch").
model Batch {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members BatchMember[]

  @@unique([orgId, name])
  @@index([orgId])
}

model BatchMember {
  batchId String
  userId  String
  addedAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([batchId, userId])
  @@index([userId])
}

/// An assessment assigned to a candidate. `token` forms the candidate's
/// personal exam link. One row per (assessment, user) — enforced by unique.
model AssessmentAssignment {
  id           String           @id @default(cuid())
  assessmentId String
  userId       String
  token        String           @unique @default(cuid())
  status       AssignmentStatus @default(INVITED)
  invitedAt    DateTime         @default(now())
  startedAt    DateTime?
  submittedAt  DateTime?
  expiresAt    DateTime?

  assessment Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt    ExamAttempt?

  @@unique([assessmentId, userId])
  @@index([token])
  @@index([userId])
  @@index([status])
}

// ============================================================
// Plan 015 — Exam-Taking Runtime
// ============================================================

/// One in-progress or completed attempt at an assigned assessment.
/// Timer is server-authoritative: deadlineAt is set at start and enforced on
/// every save/submit. questionOrder pins the shuffle so refreshes see the
/// same order.
model ExamAttempt {
  id             String    @id @default(cuid())
  assignmentId   String    @unique
  userId         String
  assessmentId   String
  startedAt      DateTime  @default(now())
  deadlineAt     DateTime
  submittedAt    DateTime?
  /// { sections: [{ sectionId, questionIds: string[] }] }
  questionOrder  Json
  currentSection Int       @default(0)

  assignment AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    ExamAnswer[]
  result     Result?

  @@index([userId])
  @@index([assessmentId])
}

/// One saved answer per (attempt, question). Autosaved as the candidate works.
model ExamAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  /// String[] to support both single- and multi-select MCQs uniformly.
  selectedOptionIds String[]
  textAnswer        String?  @db.Text
  /// codeSubmissionId — reserved for Plan 014 (Judge0). Nullable for now.
  codeSubmissionId  String?
  savedAt           DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ============================================================
// Plan 016 — Grading Engine & Results
// ============================================================

enum ResultStatus {
  /// At least one question needs manual review (subjective, or coding pre Plan 014).
  PENDING_REVIEW
  /// Fully scored; totalScore and passed are final.
  GRADED
}

/// One graded outcome per exam attempt. Auto-created when the attempt is
/// submitted (services/grading.ts gradeAttempt).
model Result {
  id           String       @id @default(cuid())
  attemptId    String       @unique
  assessmentId String
  userId       String
  status       ResultStatus @default(PENDING_REVIEW)
  totalScore   Float        @default(0)
  maxScore     Float
  percentage   Float        @default(0)
  passed       Boolean?
  gradedAt     DateTime?
  createdAt    DateTime     @default(now())

  attempt         ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionResults QuestionResult[]

  @@index([assessmentId])
  @@index([userId])
  @@index([status])
}

/// Per-question breakdown of a Result.
model QuestionResult {
  id           String  @id @default(cuid())
  resultId     String
  questionId   String
  scoreAwarded Float   @default(0)
  maxMarks     Float
  isCorrect    Boolean?
  /// True while awaiting manual review (subjective, coding). Prevents result finalisation.
  needsReview  Boolean @default(false)
  reviewedById String?
  feedback     String? @db.Text

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([questionId])
}
